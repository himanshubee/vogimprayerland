# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.env
# testing
/coverage

.env
.env.*
!.env.example

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env.local / .env.production are tracked on purpose — they hold the shared,
# non-secret config the server needs after `git pull`.
# Real secrets belong in .env.production.local, which is NEVER committed and is
# left untouched by `git pull` and `git reset --hard` during deploy.
.env.production.local
.env.development.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/public/tinymce
