S3_UPLOAD_KEY=mjuC4BVeanDN08MeCkI/zzP/zJ0BAd8IY8bezUUvSVShapTG

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://divinebabytunes07_db_user:dfSpW3bhZGqL8Xhu@vogim.aj4bb7r.mongodb.net/?appName=vogim
MONGODB_DB=vogim

# Admin panel (/admin) — choose a strong password
ADMIN_PASSWORD=changeme123@vogim
# Random string used to sign the admin session cookie (any long random value)
ADMIN_SECRET=replace-with-a-long-random-string

# Where form submissions are delivered (the ministry inbox).
SUBMISSIONS_EMAIL=vogimdeliveranceministry@gmail.com
#
# EMAIL NEEDS NO SETUP. By default submissions are emailed via FormSubmit.co —
# no account, no API key, no signup. The only one-time step is clicking the
# "Activate" link FormSubmit emails to the inbox above on the first submission.
#
# ── Optional: SMTP override (only if you ever want it) ────────────────────
# Fill these to send via your own SMTP (e.g. Brevo smtp-relay.brevo.com:587)
# instead of FormSubmit. Leave blank to keep the zero-signup FormSubmit path.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VOGIM Prayer Land <vogimdeliveranceministry@gmail.com>

# Public site URL (used by sitemap.xml / robots.txt)
NEXT_PUBLIC_SITE_URL=https://www.vogimprayerland.org

# ── Flutterwave (payment gateway for /give) ──────────────────────────────
# V3 keys from the Flutterwave dashboard → Settings → API Keys.
# TEST keys below — swap for the LIVE keys (FLWSECK-…) before taking real gifts.
# Only the SECRET key is used: the site creates a hosted checkout link
# server-side, so no key is ever exposed to the browser.
FLW_PUBLIC_KEY=FLWPUBK-ca9010909768104b88b39f4509eaedf9-X
FLW_SECRET_KEY=FLWSECK-167d49b5afe7d79827447d85f9c553b5-19faee19713vt-X
FLW_ENCRYPTION_KEY=167d49b5afe719a2a337d0df
# Paste this exact value into Flutterwave → Settings → Webhooks → "Secret hash",
# and set the webhook URL to https://www.vogimprayerland.org/api/give/webhook/
# (the trailing slash is required — trailingSlash is on, so the slash-less URL
#  answers with a 308 redirect that the webhook sender will not follow).
FLW_SECRET_HASH=167d49b5afe719a2a337d0dfBEE


# ── PayPal (bookshop checkout) ───────────────────────────────────────────
# REST API credentials from developer.paypal.com → Apps & Credentials.
PAYPAL_CLIENT_ID=BAAME01xMJuu8GTShua32cLX7XsYSp16wVbia8A9X7-LjkHh8emGdNFPouWVw9NM1R3qtMyNix_uhf841c
PAYPAL_SECRET=EPOoc5RuU7DpQRaXbk-ETHxRaEYCAaEI_1hfQjmVRoLh7ljZ98yd0M5Oae1GxbraBuhOv3U2KvlVT9Su
# "live" takes real money. Any other value (including blank) means sandbox.
PAYPAL_ENV=live
# PayPal → your app → Webhooks. URL: /api/shop/paypal/webhook/ (trailing slash
# required). Subscribe to CHECKOUT.ORDER.APPROVED + PAYMENT.CAPTURE.COMPLETED.
PAYPAL_WEBHOOK_ID=7P177675T96259122

# ── Paystack (bookshop checkout) ─────────────────────────────────────────
# Secret key from Paystack → Settings → API Keys & Webhooks (sk_test_ / sk_live_).
# Also signs the webhook, so there is no separate webhook secret.
# Webhook URL: /api/shop/paystack/webhook/ (trailing slash required).
PAYSTACK_SECRET_KEY=sk_live_27fdea53d9aa140e8c5d9bc624f6ff70b8a3e14e

# ── Which currencies each gateway settles ─────────────────────────────────
# Defaults match what these ministry accounts are actually enabled for:
#
#   Paystack     NGN only   (the account has no dollar channel — a USD charge
#                            fails with "No active channel to process
#                            transaction"). Paystack does not convert, so it is
#                            shown only to shoppers already paying in naira.
#   PayPal       USD only   (PayPal settles no African currency; sending NGN
#                            returns 422 CURRENCY_NOT_SUPPORTED). PayPal does
#                            convert, so it is always offered and charges USD.
#   Flutterwave  everything
#
# Override once an account gains a channel — comma-separated, no code change:
#
#   PAYSTACK_CURRENCIES=NGN,USD      -> after Paystack enables dollars
#   PAYPAL_CURRENCIES=USD,GBP,EUR    -> to also offer sterling and euro
#
# An override is checked against what the gateway genuinely supports, so a typo
# can never invent support and produce a rejected charge. Leave blank for the
# defaults above.
PAYSTACK_CURRENCIES=
FLUTTERWAVE_CURRENCIES=
PAYPAL_CURRENCIES=
