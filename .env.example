# Copy this file to a protected, gitignored environment file.
# Never commit real credentials. Rotate any credential that was previously committed.

NEXT_PUBLIC_SITE_URL=https://www.vogimprayerland.org
NEXT_PUBLIC_CHATWAY_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
# care_refresh_v1 staged release. Server stage: off | staff | 10 | 50 | 100.
# "off" (or unset) rolls back to the previous admin dashboard.
CARE_REFRESH_V1=staff
# Browser-side draft saving on request forms (true once CARE_REFRESH_V1 reaches 100).
NEXT_PUBLIC_CARE_REFRESH_V1=false

MONGODB_URI=
MONGODB_DB=vogim

# Individual staff accounts with roles and MFA. One JSON array; create each entry with
# STAFF_PASSWORD='...' node scripts/staff-user.mjs <username> <intercessor|pastor|finance|admin>
ADMIN_USERS=
# Legacy shared password, used only while ADMIN_USERS is empty.
ADMIN_PASSWORD=
# Long random value. Signs staff sessions.
ADMIN_SECRET=
# Bearer token (24+ characters) for the daily retention job: POST /api/admin/retention/
RETENTION_TOKEN=

SUBMISSIONS_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VOGIM Prayer Land <example@example.org>

S3_UPLOAD_URL=
S3_UPLOAD_KEY=

# Auto-blog (Admin > Auto-blog). Writes articles and featured images through OpenRouter.
OPENROUTER_API_KEY=
# Optional model overrides (any OpenRouter model id).
OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# Bearer token (24+ characters) for the daily auto-blog tick: POST /api/admin/autoblog/
AUTOBLOG_TOKEN=

# Use gateway test credentials for local development and QA.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=
FLUTTERWAVE_CURRENCIES=

PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCIES=
